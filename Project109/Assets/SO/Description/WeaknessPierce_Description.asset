  path: WeaknessPierce
  cardName: "\uC57D\uC810 \uAD00\uD1B5"
  description: "\uD53C\uD574\uB97C [0] \uC90D\uB2C8\uB2E4.\n\uB300\uC0C1\uC774 \uCD9C\uD608
    \uC0C1\uD0DC\uB77C\uBA74 \uD53C\uD574\uB7C9\uC774 [1]\uBC30 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  extraDescriptions:
  - name: "\uCD9C\uD608"
    description: "\uB300\uC0C1\uC758 \uD134\uC774 \uB05D\uB0A0 \uB54C\uB9C8\uB2E4
      (1 + (2^\uC911\uCCA9\uD69F\uC218))\uB9CC\uD07C \uD53C\uD574\uB97C \uC785\uC2B5\uB2C8\uB2E4.\\n2\uD134
      \uB3D9\uC548 \uAC31\uC2E0\uB418\uC9C0 \uC54A\uC73C\uBA74 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4."
  masteryDescriptions:
  - path: WeaknessPierce_DamageAmp
    name: "\uD53C\uD574 \uC99D\uD3ED"
    description: "\uAE30\uBCF8 \uB370\uBBF8\uC9C0\uAC00 2 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    maxUpgradeCount: 0
  - path: WeaknessPierce_WeakPoint
    name: "\uC57D\uC810 \uD3EC\uCC29"
    description: "\uCD9C\uD608 \uC0C1\uD0DC\uC77C \uB54C \uD53C\uD574\uB7C9\uC774
      0.5\uBC30 \uCD94\uAC00\uB85C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    maxUpgradeCount: 0
  - path: WeaknessPierce_Agility
    name: "\uAC00\uBCBC\uC6B4 \uBAB8\uB180\uB9BC"
    description: "\uC18C\uBAA8 \uC2A4\uD0DC\uBBF8\uB108\uAC00 10 \uAC10\uC18C\uD569\uB2C8\uB2E4."
    maxUpgradeCount: 3
  - path: WeaknessPierce_ExcessiveBleeding
    name: "\uACFC\uB2E4 \uCD9C\uD608"
    description: "\uD53C\uD574\uB97C \uC785\uC740 \uB300\uC0C1\uC774 \uCD9C\uD608
      \uC0C1\uD0DC\uB77C\uBA74 \uC989\uC2DC \uCD9C\uD608 \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4."
