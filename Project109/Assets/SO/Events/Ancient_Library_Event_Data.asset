  stages:
  - stageID: START
    stageDescription: "\uAE38\uC744 \uAC00\uB358 \uC911 \uC624\uB798\uB41C \uC218\uB9CE\uC740
      \uCC45\uACFC \uC885\uC774\uAC00 \uAC00\uB4DD\uD55C \uCC45\uC7A5\uB4E4\uC774
      \uAC00\uB4DD\uD55C \uACF3\uC744 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4.\n \uC548\uC740
      \uC0DD\uAC01\uBCF4\uB2E4 \uC544\uB291\uD588\uC73C\uBA70, \uB2E4\uC591\uD55C
      \uC9C0\uC2DD\uB4E4\uC774 \uAC00\uB4DD\uD55C \uCC45\uACFC \uC885\uC774\uB4E4\uC774
      \uAC00\uB4DD\uD588\uC2B5\uB2C8\uB2E4.\n \uC2E0\uAE30\uD558\uAC8C\uB3C4 \uC0AC\uB78C\uC758
      \uD754\uC801\uC740 \uBCF4\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    choices:
    - description: "\uC5EC\uB7EC \uC815\uBCF4\uB4E4\uC744 \uC218\uC9D1\uD55C\uB2E4."
