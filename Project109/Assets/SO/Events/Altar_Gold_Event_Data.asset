  stages:
  - stageID: START
    stageDescription: "\uBC29\uC5D0 \uC218\uC0C1\uD574 \uBCF4\uC774\uB294 \uC81C\uB2E8\uC744
      \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4.\n \uC81C\uB2E8 \uC704\uC5D0\uB294 \uCEE4\uB2E4\uB780
      \uD669\uAE08\uC774 \uC62C\uB824\uC838 \uC788\uC73C\uBA70, \uC8FC\uBCC0\uC5D0\uB3C4
      \uAE08\uD654\uAC00 \uB5A8\uC5B4\uC838 \uC788\uC2B5\uB2C8\uB2E4."
