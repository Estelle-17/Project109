      randomLoseRelic: []
  - stageID: END_LESS_LIGHT_PROCESS
    stageDescription: "\uC57D\uD55C \uBE5B\uC774 \uB098\uC624\uB294 \uBB38\uC744
      \uC5F4\uACE0 \uB4E4\uC5B4\uAC00\uC790, \uBE5B\uC774 \uB2F9\uC2E0\uC758 \uBAB8\uC744
      \uAC10\uC2F8\uAE30 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4.\n \uC7A0\uC2DC \uD6C4
      \uC815\uC2E0\uC744 \uCC28\uB9AC\uC790 \uBAB8\uC744 \uAC10\uC2FC \uBE5B\uC740
      \uB208\uCE58\uCC44\uAE30\uB3C4 \uC804\uC5D0 \uC0AC\uB77C\uC838 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\n
      \uB208 \uAE5C\uC9DD\uD560 \uC0AC\uC774\uC5D0 \uBC8C\uC5B4\uC9C4 \uC77C\uC774\uC600\uC9C0\uB9CC,
      \uC790\uC2E0\uC758 \uBAB8\uC740 \uC880 \uB354 \uD65C\uAE30\uAC00 \uB3C8\uB2E4\uB294
      \uAC83\uC744 \uC54C\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    choices:
    - description: "\uC9C0\uB098\uAC04\uB2E4."
      nextStageID: 
      useItems: []
      getItems: []
      randomLoseCard: []
      randomLoseRelic: []
  - stageID: END_DARK_SMOKE_PROCESS
    stageDescription: "\uBB38\uC744 \uC5F4\uC790, \uC5B4\uB450\uC6B4 \uC5F0\uAE30\uAC00
      \uB2F9\uC2E0\uC758 \uBAB8\uC744 \uAC10\uC2F8\uAE30 \uC2DC\uC791\uD588\uC73C\uBA70
