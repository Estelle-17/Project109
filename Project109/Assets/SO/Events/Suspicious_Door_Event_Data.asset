  stages:
  - stageID: START
    stageDescription: "\uC791\uC740 \uBC29\uC5D0 \uC218\uC0C1\uD55C \uBB38\uC774
      \uB450 \uAC1C\uAC00 \uC788\uC2B5\uB2C8\uB2E4...\n \uD55C \uCABD \uBB38\uC740
      \uC57D\uD55C \uD770\uC0C9 \uBE5B\uC744 \uB0B4\uACE0 \uC788\uC5C8\uC73C\uBA70,
      \uB2E4\uB978 \uD55C \uCABD\uC740 \uAC80\uC740\uC0C9 \uC5F0\uAE30\uAC00 \uD758\uB7EC\uB098\uC624\uACE0
      \uC788\uC2B5\uB2C8\uB2E4.\n \uB2E4\uB978 \uBB38\uC740 \uBCF4\uC774\uC9C0 \uC54A\uAE30\uC5D0
      \uD55C \uACF3\uC744 \uC120\uD0DD\uD558\uC5EC \uC9C0\uB098\uAC00\uC57C \uD560
      \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
    choices:
    - description: "\uC57D\uD55C \uBE5B\uC774 \uB098\uB294 \uBB38\uC73C\uB85C \uAC04\uB2E4."
      nextStageID: END_LESS_LIGHT_PROCESS
      useItems: []
      getItems:
      - itemType: UpgradeCard
        value: 1
        name: 
      randomLoseCard: []
      randomLoseRelic: []
    - description: "\uAC80\uC740\uC0C9 \uC5F0\uAE30\uAC00 \uD750\uB974\uB294 \uBB38\uC73C\uB85C
        \uAC04\uB2E4."
