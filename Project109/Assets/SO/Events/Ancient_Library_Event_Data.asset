  - stageID: END_TAKE_INFOMATION_PROCESS
    stageDescription: "\uB2F9\uC2E0\uC740 \uB358\uC804, \uAE30\uC5B5, \uC804\uD22C,
      \uC0DD\uD65C \uB4F1 \uB2E4\uC591\uD55C \uC815\uBCF4\uB4E4\uC758 \uC9D1\uD569\uCCB4\uAC00
